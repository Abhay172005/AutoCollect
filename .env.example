# ─────────────────────────────────────────────
#  AutoCollect — Environment Variables Example
#  Copy this file to .env and fill in values.
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/autocollect

# ── Authentication ────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRE=7d

# ── Meta WhatsApp Cloud API ───────────────────
# Private System User access token from Meta Business Manager.
# Keep this secret — never expose in frontend or logs.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token

# The Phone Number ID for the registered Amar Steel Industries sender.
# Production value: 1381154951748220
WHATSAPP_PHONE_NUMBER_ID=1381154951748220

# Graph API version to use. Production confirmed on v26.0.
WHATSAPP_API_VERSION=v26.0

# Exact name of the approved Meta message template.
WHATSAPP_TEMPLATE_NAME=pending_bill_payment_reminder

# Exact language code from the approved template in Meta Business Manager
# (e.g. "en" for English, "en_US" for US English).
WHATSAPP_TEMPLATE_LANGUAGE=en

# Secret used to verify Meta's webhook subscription handshake.
# Generate a random string and set the same value in Meta Business Manager.
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_secret_string

# Meta app secret (found in Meta App Dashboard → Settings → Basic).
# Used to validate the X-Hub-Signature-256 on incoming webhook events.
META_APP_SECRET=your_meta_app_secret

# Feature gate: set to "true" ONLY after:
#   1. The message template has been approved in Meta Business Manager.
#   2. The webhook endpoint is reachable and verified.
#   3. Production sending has been tested end-to-end.
# Defaults to "false" — sending is disabled until explicitly enabled.
WHATSAPP_SEND_ENABLED=false
